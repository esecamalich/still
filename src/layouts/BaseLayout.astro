---
// src/layouts/BaseLayout.astro

// @ts-ignore: no type declarations for external side-effect stylesheet
import '@mstm/mstm-styles';
import '@/styles/global.css';
import SiteNavBar from "@/components/navigation/SiteNavBar.astro";
//import Newsletter from "@/components/sections/Newsletter.astro";
//import Footer from "@/components/sections/Footer.astro";

import SEOHead from "@/components/meta/SEOHead.astro";

import Schema from "@/components/meta/Schema.astro";
import {
  websiteSchema, orgSchema, breadcrumbsSchema,
  courseSchema, productSchema, blogPostingSchema, faqSchema, personSchema
} from "@/lib/schema";

const { 
  title, 
  description, 
  image, 
  canonical, 
  className = '', 
  newsletter = true,
  navigation = true,
  footer = true,
  robots,
  type,
  schemaType,       // 'course' | 'product' | 'blog' | 'faq' | 'about' | undefined
  schemaData,       // object for the chosen type
  breadcrumbs,      // [{ name, url }, ...]
  customSchemas     // advanced override: array of full JSON-LD objects
} = Astro.props;

// Derive base URL from canonical (falls back to site root)
const baseUrl = (() => {
  try { return new URL(canonical).origin; } catch { return "https://camali.ch"; }
})();

// Always-on site schemas
const siteSchemas = [
  websiteSchema(baseUrl),
  orgSchema(baseUrl),
  ...(breadcrumbs ? [breadcrumbsSchema(breadcrumbs)] : [])
];

// Page-specific schemas
let pageSchemas: any[] = [];
if (Array.isArray(customSchemas)) {
  pageSchemas = customSchemas;
} else if (schemaType && schemaData) {
  switch (schemaType) {
    case 'course': pageSchemas.push(courseSchema(schemaData)); break;
    case 'product': pageSchemas.push(productSchema(schemaData)); break;
    case 'blog': pageSchemas.push(blogPostingSchema(schemaData)); break;
    case 'faq': pageSchemas.push(faqSchema(schemaData.qas)); break;
    case 'about': pageSchemas.push(personSchema(schemaData.person)); break;
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8RJ7ZG31LQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8RJ7ZG31LQ');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEOHead {...{ title, description, image, canonical, robots, type }} />

    <link 
      rel="preload" 
      href="/fonts/Inter-VariableFont_opsz,wght.ttf" 
      as="font" 
      type="font/ttf" 
      crossorigin="anonymous" 
    />
    <link 
      rel="preload" 
      href="/fonts/Inter-Italic-VariableFont_opsz,wght.ttf" 
      as="font" 
      type="font/ttf" 
      crossorigin="anonymous" 
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="robots" href="/robots.txt" />

    <script is:inline>
      const w = window;

      if (!w.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const root = document.documentElement;
        root.dataset.pageTransition = "pending";
        root.dataset.pageTransitionTimer = String(
          w.setTimeout(() => {
            root.removeAttribute("data-page-transition");
            delete root.dataset.pageTransitionTimer;
          }, 1200)
        );
      }
    </script>

    {/* Site-wide JSON-LD */}
    {siteSchemas.map((s) => <Schema data={s} />)}
    {/* Page-specific JSON-LD */}
    {pageSchemas.map((s) => <Schema data={s} />)}
  </head>
  <body class={className} >

    {/* Navbar slot with default */}
    <slot name="nav">
      {navigation && <SiteNavBar />}
    </slot>   

    <main>
      <slot />
    </main>

    <div
      class="essay-preview-flyout"
      data-essay-preview-flyout
      data-no-page-transition
      aria-hidden="true"
    >
      <img class="essay-preview-flyout__image" alt="" />
    </div>

    <!--
    {newsletter && <Newsletter />}
    {footer && <Footer />}
    -->
    
    <script is:inline>
      document.addEventListener("click", (ev) => {
        const target = ev.target;
        if (!(target instanceof Element)) return;

        const el = target.closest("[data-ga]");
        if (!el || typeof window.gtag !== "function") return;

        const action   = el.getAttribute("data-ga");           // e.g. "buy"
        const label    = el.getAttribute("data-ga-label");     // optional
        const category = el.getAttribute("data-ga-category");  // optional

        window.gtag("event", action, {
          event_category: category || "ga",
          event_label: label || el.textContent?.trim(),
        });
      });

      // Optional: propagate UTMs to marked links
      const qs = window.location.search.slice(1);
      if (qs) {
        document.querySelectorAll("a[data-append-utms]").forEach((a) => {
          try {
            const url = new URL(a.href);
            const incoming = new URLSearchParams(qs);
            incoming.forEach((v, k) => { 
              if (!url.searchParams.has(k)) url.searchParams.set(k, v); 
            });
            a.href = url.toString();
          } catch {}
        });
      }
    </script>

    <script is:inline>
      (() => {
        if (window.__essayPreviewInit) return;
        window.__essayPreviewInit = true;

        const supportsHover = window.matchMedia(
          "(hover: hover) and (pointer: fine)",
        ).matches;
        if (!supportsHover) return;

        const flyout = document.querySelector("[data-essay-preview-flyout]");
        const img = flyout?.querySelector("img");
        if (!flyout || !img) return;

        let active = null;
        const offset = 16;

        const move = (event) => {
          flyout.style.setProperty("--thumb-x", `${event.clientX + offset}px`);
          flyout.style.setProperty("--thumb-y", `${event.clientY + offset}px`);
        };

        document.addEventListener("pointerover", (event) => {
          const target =
            event.target instanceof Element
              ? event.target.closest("[data-essay-preview]")
              : null;
          if (!target) return;

          const src = target.getAttribute("data-thumbnail");
          if (!src) return;

          active = target;
          img.src = src;
          flyout.setAttribute("data-visible", "true");
          move(event);
        });

        document.addEventListener("pointermove", (event) => {
          if (!active) return;
          move(event);
        });

        document.addEventListener("pointerout", (event) => {
          if (!active) return;
          if (!(event.target instanceof Element)) return;
          if (!active.contains(event.target)) return;
          if (
            event.relatedTarget instanceof Node &&
            active.contains(event.relatedTarget)
          ) {
            return;
          }
          active = null;
          flyout.removeAttribute("data-visible");
        });

        const preload = () => {
          const sources = new Set(
            Array.from(document.querySelectorAll("[data-essay-preview]"))
              .map((node) => node.getAttribute("data-thumbnail"))
              .filter(Boolean),
          );
          sources.forEach((src) => {
            const img = new Image();
            img.decoding = "async";
            img.loading = "eager";
            img.src = src;
          });
        };

        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(preload, { timeout: 1500 });
        } else {
          window.setTimeout(preload, 350);
        }
      })();
    </script>
    
    <script>
		import { gsap } from "gsap";

		const clearPageTransitionFlag = () => {
			const root = document.documentElement;
			root.removeAttribute("data-page-transition");

			const timerId = root.dataset.pageTransitionTimer;
			if (timerId) {
				window.clearTimeout(Number(timerId));
				delete root.dataset.pageTransitionTimer;
			}
		};

		const animatePage = () => {
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				clearPageTransitionFlag();
				return;
			}

			const targets = Array.from(
				document.querySelectorAll(
					"body *:not(script):not(style):not([data-no-page-transition])",
				)
			);

			if (!targets.length) {
				clearPageTransitionFlag();
				return;
			}

			clearPageTransitionFlag();

			gsap.set(targets, { autoAlpha: 0, y: 16 });
			gsap.to(targets, {
				autoAlpha: 1,
				y: 0,
				duration: 0.65,
				stagger: 0.05,
				ease: "power2.out",
			});
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", animatePage, { once: true });
		} else {
			animatePage();
		}
	</script>
  
  </body>
</html>
