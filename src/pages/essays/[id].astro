---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import Text from '@/components/primitives/Text.astro';
import Stack from '@/components/primitives/Stack.astro';
import RichText from '@/components/primitives/RichText.astro';
import Link from '@/components/primitives/Link.astro';
import Image from '@/components/primitives/Image.astro';
import Socials from '@/components/custom/Socials.astro';
import TranslatedProfile from '@/components/custom/TranslatedProfile.astro';
import Divider from '@/components/primitives/Divider.astro';

import { MoveLeft } from '@lucide/astro';

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';

// Generate new path from every collection entry
export async function getStaticPaths() {
    const posts = await getCollection('essays');
    return posts.map(post => ({
        params: { id: post.id },
        props: { post },
    }));
}

type Props = {
    post: CollectionEntry<'essays'>;
};

const { post } = Astro.props as Props;
const { Content } = await render(post);

const allArticles = await getCollection('essays');
const categories = post.data.categories ?? [];
const otherArticles = allArticles.filter((article) => article.id !== post.id && article.data.draft != true);
const sortedArticles = [...otherArticles].sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const relatedByCategory = categories.length
    ? sortedArticles.filter((article) => (article.data.categories ?? []).some((category) => categories.includes(category)))
    : [];

const relatedArticles = [...relatedByCategory, ...sortedArticles]
    .filter((article, index, self) => self.findIndex(({ id }) => id === article.id) === index)
    .slice(0, 3);

// SEO metadata generation
import { generateSEO } from '@/utils/generateSEO.ts';
const seo = generateSEO({
  title: post.data.title,
  description: post.data.description,
  slug: `${post.data.slug ?? post.id}`,
  image: post.data.image,
  prefix: '/essays',
  type: 'article',
});
---

<BaseLayout navigation={false} {...seo}>
    <Section size="sm">
        <Stack gap={{ base: '3xl' }} style="max-width: 75ch;" align={{ base: 'start' }}>
            <TranslatedProfile />
            <Stack
                id="back-button"
                as="a"
                href={Astro.request.headers.get('referer')?.includes(Astro.site?.origin || '') ? Astro.request.headers.get('referer') : '/'}
                direction={{ base: 'row' }}
                gap={{ base: 'sm' }}
                style="color: var(--color-neutral-500); margin-block: 18px;"
                align={{ base: 'left' }}
            >
                <MoveLeft size={16} />
                <Text size="body-sm">Back</Text>
            </Stack>
            <Text as="h1">
                {post.data.title}
            </Text>
            { post.data.introduction && (
                <RichText markdown={post.data.introduction} class="text-body-xl color-text-subtle" />
            )}
            { post.data.thumbnail && (
                <Image 
                    src={post.data.thumbnail}
                    style="width: var(--size-container-full)"
                />
            )}
            <Stack id="article-content" class="color-text-subtle">
                <Content />
            </Stack>
        </Stack>
    </Section>

    <Section size="sm" paddingTop="none" paddingBottom="none">
        <Stack>
            <Divider />
            <Divider />
        </Stack>
    </Section>

    { relatedArticles.length > 0 && (
        <Section id="related-essays" size="sm">
            <Stack gap={{ base: '3xl' }}>
                <Text
                    as="h3"
                    size="body-xs"
                    class="text-uppercase text-medium"
                    variant="subtle"
                    style="letter-spacing: 2px"
                >
                    Related Articles
                </Text>
                { relatedArticles.map((article) => (
                    <Link href={`/essays/${article.data.slug ?? article.id}`}>
                        <Text class="text-medium">
                            {article.data.title}
                        </Text>
                        <Text class="text-medium" variant="subtle">
                            {article.data.excerpt}
                        </Text>
                    </Link>
                ))}
            </Stack>
        </Section>
    )}

    <Socials />

</BaseLayout>
