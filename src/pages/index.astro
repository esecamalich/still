---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import Grid from "@/components/primitives/Grid.astro";
import Masonry from "@/components/primitives/Masonry.astro";
import Text from "@/components/primitives/Text.astro";
import RichText from "@/components/primitives/RichText.astro";
import Image from "@/components/primitives/Image.astro";
import Footer from "@/components/custom/Footer.astro";
import TranslatedProfile from "@/components/custom/TranslatedProfile.astro";
import Divider from "@/components/primitives/Divider.astro";
import EssayPreview from "@/components/sections/EssayPreview.astro";

import { getCollection } from 'astro:content';

// Load Articles/Essays
const allArticles = await getCollection('essays')

const { latestArticles = allArticles, limit = 5 } = Astro.props;

const sortedArticles = latestArticles
	.filter((a) => a.data.draft != true) // Exclude drafts
	.sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()) // Sort by published date
	.slice(0, limit ?? Infinity) // Only slices if limit is defined


// Load Links
const allLinks = await getCollection('links')

const links = await getCollection(
  "links",
  ({ data }) => data.status === "published" // Filter Callback
);

// SEO configuration
import { generateSEO } from '@/utils/generateSEO.ts';
const seo = generateSEO({
  slug: '/',
});
---

<BaseLayout navigation={false} {...seo}>

	<Section 
		id="bio" 
		size="sm"
		padding="3xl"
		paddingTop="6xl"
		paddingBottom="none"	
	>
		<Stack gap={{ base: '3xl' }} >
			<TranslatedProfile />

			<Stack gap={{ base: 'xs' }}>
				<Text as="h1" size="heading-h3">
					Still
				</Text>
				<Text as="h2" variant="subtle" size="heading-h4" style="font-weight: 400;">
					A quiet Astro theme for thoughtful publishing
				</Text>
			</Stack>

			<RichText 
				class="text-subtle last-p-marginless"
				markdown={`
In a web increasingly shaped by speed, noise, and constant updates,
**Still** is a space designed for slower experiences.

This theme focuses on what makes personal websites meaningful:
clear typography, thoughtful layouts, and a comfortable place for ideas to unfold.

Rather than adding more complexity, Still embraces restraint.
It is made for essays, notes, photography, and long-form writing —
for people who want a website that feels calm, durable, and entirely their own.

<br/>

**Built with:**
- <a href="https://astro.build/" target="_blank">Astro</a>: A modern framework for content-focused websites
- <a href="https://www.markdownguide.org/" target="_blank">Markdown</a>: Simple, portable, and timeless writing
- <a href="https://www.w3schools.com/js/" target="_blank">JavaScript</a>: Fast experiences without unnecessary layers
				`}
			/>
		</Stack>
	</Section>

	<Section 
		id="featured-images"
		padding="2xl"
		paddingBottom="none"
		size="xl"
	>
		<Masonry
			gap="3xl"
			columns={{ base: 1, sm: 2, md: 3 }}
		>
			<Image 
				src="/images/sean-fahrenbruch-CL5EwIk4wZc-unsplash.webp"
				style="border-radius: var(--radius-lg);"
				title="Sean Fahrenbruch | MacBook inspired desktop gradient in blue."
			/>
			<Image 
				src="/images/sean-fahrenbruch-wBTB9TJivco-unsplash.webp"
				style="border-radius: var(--radius-lg);"
				title="Sean Fahrenbruch | MacBook inspired desktop gradient in yellow."
			/>
			<Image 
				src="/images/sean-fahrenbruch-yebiAon12SE-unsplash.webp"
				style="border-radius: var(--radius-lg);"
				title="Sean Fahrenbruch | MacBook inspired desktop gradient in red."
			/>
		</Masonry>	
	</Section>

	<Section
		id="essays"
		size="sm"
		padding="3xl"
		paddingBottom="6xl"
	>
		<Stack
			gap={{ base: '3xl' }}
		>
			<Text
				as="h3"
				size="body-xs"
				class="text-uppercase text-medium"
				variant="subtle"
				style="letter-spacing: 2px"
			>
				Essays
			</Text>
			{ sortedArticles.map((article) => (
				<EssayPreview
					href={`/essays/${article.data.slug ?? article.id}`}
					title={article.data.title}
					excerpt={article.data.excerpt}
					thumbnail={article.data.thumbnail}
				/>
			))}
		</Stack>
	</Section>

	<Footer />

</BaseLayout>
