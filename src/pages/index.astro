---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import Grid from "@/components/primitives/Grid.astro";
import Masonry from "@/components/primitives/Masonry.astro";
import Text from "@/components/primitives/Text.astro";
import RichText from "@/components/primitives/RichText.astro";
import Image from "@/components/primitives/Image.astro";
import Socials from "@/components/custom/Socials.astro";
import TranslatedProfile from "@/components/custom/TranslatedProfile.astro";
import Divider from "@/components/primitives/Divider.astro";
import EssayPreview from "@/components/sections/EssayPreview.astro";

/*
const articles = [
	{ title: 'Working in creative bursts', href: '#', excerpt: 'Exploring the power of creativity in short, intense sessions for maximum productivity.' },
	{ title: 'So they changed the algorithm?', href: '#', excerpt: 'A deep dive into the implications of algorithm changes in our digital landscape.' },
	{ title: 'On the nature of the internet', href: '#', excerpt: 'Reflecting on the internet’s evolution and its impact on society and communication.' },
	{ title: 'No system will save you', href: '#', excerpt: 'Discussing the limitations of technology and the importance of human agency.' },
	{ title: 'All hail our new knowledge overlord!', href: '#', excerpt: 'Examining the rise of AI and its role in shaping our access to information.' },
	{ title: 'A website is never just a website', href: '#', excerpt: 'Understanding the multifaceted nature of websites beyond mere digital presence.' },
]
*/

import { getCollection } from 'astro:content';
const allArticles = await getCollection('essays')

const { latestArticles = allArticles, limit = 5 } = Astro.props;

const sortedArticles = latestArticles
	.filter((a) => a.data.draft != true) // Exclude drafts
	.sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()) // Sort by published date
	.slice(0, limit ?? Infinity) // Only slices if limit is defined

// SEO configuration
import { generateSEO } from '@/utils/generateSEO.ts';
const seo = generateSEO({
  slug: '/',
});
---

<BaseLayout navigation={false} {...seo}>

	<Section 
		id="bio" 
		size="sm"
		padding="3xl"
		paddingTop="6xl"
		paddingBottom="none"	
	>
		<Stack gap={{ base: '3xl' }} >
			<TranslatedProfile />
			<Stack gap={{ base: 'xs' }}>
				<Text as="h1" size="heading-h3">
					Sergio Camalich Morales
				</Text>
				<Text as="h2" variant="subtle" size="heading-h4" style="font-weight: 400;">
					Chief Maker of Stuff
				</Text>
			</Stack>
			<RichText 
				class="text-subtle last-p-marginless"
				markdown={`
In a world attempting to reduce the complexity of an individual into a few neat categories, 
I use the word "stuff" deliberately, as a refusal to collapse my work 
into a single role, medium, or outcome.

Whether through <a href="https://makestuffthatmatters.com/" target="_blank" >design & development</a>, 
<a href="https://strangevisitations.com/" target="_blank" >photography</a>, writing, or movement ––
I'm drawn to the things hiding in plain sight: symbols, patterns, stories, 
and the unexpected similarities between seemingly different worlds.

<br/>

**Currently working on:**
- <a href="https://strangevisitations.com/" target="_blank" >Strange Visitations</a>: Symbols of Religion, Culture, and Tradition in Modern Bali
				`}
			/>
		</Stack>
	</Section>

	<Section 
		id="featured-images"
		padding="2xl"
		paddingBottom="none"
		size="xl"
	>
		<Masonry
			gap="3xl"
			columns={{ base: 1, sm: 2, md: 3 }}
		>
			<Image 
				src="/images/strange-visitations-2026-06-22--01.webp"
				style="border-radius: var(--radius-lg);"
				title="Rooster in front of yellow background | Strange Visitations © Sergio Camalich Morales 2021"
			/>
			<Image 
				src="/images/strange-visitations-2026-06-22--02.webp"
				style="border-radius: var(--radius-lg);"
				title="Ayam | Strange Visitations © Sergio Camalich Morales 2022"
			/>
			<Image 
				src="/images/strange-visitations-2026-06-22--03.webp"
				style="border-radius: var(--radius-lg);"
				title="Gerobak Bakso Ayam during ceremony | Strange Visitations © Sergio Camalich Morales 2023"
			/>
			<Image 
				src="/images/strange-visitations-2026-06-22--04.webp"
				style="border-radius: var(--radius-lg);"
				title="Detail of a mobile petrol pump | Strange Visitations © Sergio Camalich Morales 2023"
			/>
			<Image 
				src="/images/strange-visitations-2026-06-22--06.webp"
				style="border-radius: var(--radius-lg);"
				title="Man dressed as clown | Strange Visitations © Sergio Camalich Morales 2024"
			/>
			<Image 
				src="/images/strange-visitations-2026-06-22--07.webp"
				style="border-radius: var(--radius-lg);"
				title="Bengkel | Strange Visitations © Sergio Camalich Morales 2023"
			/>
			<Image 
				src="/images/strange-visitations-2026-06-22--08.webp"
				style="border-radius: var(--radius-lg);"
				title="Entrance to a balinese compound | Strange Visitations © Sergio Camalich Morales 2023"
			/>
			<Image 
				src="/images/strange-visitations-2026-06-22--cover.webp"
				style="border-radius: var(--radius-lg);"
				title="Offering next to a Potong Rambut | Strange Visitations © Sergio Camalich Morales 2021"
			/>
		</Masonry>	
	</Section>

	<Section
		id="latest-essays"
		size="sm"
		padding="3xl"
		paddingBottom="6xl"
	>
		<Stack
			gap={{ base: '3xl' }}
		>
			<Text
				as="h3"
				size="body-xs"
				class="text-uppercase text-medium"
				variant="subtle"
				style="letter-spacing: 2px"
			>
				Latest Essays
			</Text>
			{ sortedArticles.map((article) => (
				<EssayPreview
					href={`/essays/${article.data.slug ?? article.id}`}
					title={article.data.title}
					excerpt={article.data.excerpt}
					thumbnail={article.data.thumbnail}
				/>
			))}
		</Stack>
	</Section>

	<Socials />

</BaseLayout>
