---
import styles from './Section.module.css';

const {
  id = '',        // section anchor
  class: className = '',  // extra classes
  padding = 'global',     // e.g. 'none', 'sm', 'lg', 'global'
  paddingTop,    // optional, defaults to --space-6xl
  paddingBottom, // optional, defaults to --space-6xl
  size = 'xl',            // e.g. 'sm', 'md', 'xl', 'fluid'
  as = 'section', // HTML element type
} = Astro.props;

const Tag = as;
const paddingTopClass = paddingTop ? styles[`section__padding-top--${paddingTop}`] : '';
const paddingBottomClass = paddingBottom ? styles[`section__padding-bottom--${paddingBottom}`] : '';

const sectionClasses = [
  styles.section,
  paddingTopClass,
  paddingBottomClass,
  className,
].filter(Boolean).join(' ');
---

<Tag
  id={id}
  class={sectionClasses}
>
  <div class={`padding-${padding}`}>
    <div class={`container-${size}`}>
      <slot />
    </div>
  </div>
</Tag>
