---
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import Link from "@/components/primitives/Link.astro";
import Text from "@/components/primitives/Text.astro";

const socials = [
	{ name: 'IG', href: 'https://www.instagram.com/camali.ch/'},
	{ name: 'YT', href: 'https://www.youtube.com/@camali_ch'},
	{ name: 'GH', href: 'https://github.com/esecamalich'},
	{ name: 'X', href: 'https://x.com/camali_ch'},
	{ name: 'Email', href: 'mailto:sergio@camali.ch'},
]

const year = new Date().getFullYear();
---

<Section
    paddingTop="none"
    paddingBottom="6xl"
    size="sm"
>
    <Stack>
        <Stack direction={{ base: 'row' }} class="text-body-sm">
            { socials.map((social) => (
                <Link href={social.href} external={true}>
                    {social.name}
                </Link>
            ))}
        </Stack>
        <Stack
            direction={{ base: 'column' }} 
            class="text-body-sm"
        >
            <Text
                variant="subtle"
            >
                {year} © Sergio Camalich. All Rights Reserved.
            </Text>
            <Text
                variant="subtle"
            >
                Built by
                <Link
                    href="https://www.makestuffthatmatters.com"
                    external={true}
                >
                    Make Stuff That Matters

                ✨
                </Link>
            </Text>
        </Stack>
    </Stack>
</Section>